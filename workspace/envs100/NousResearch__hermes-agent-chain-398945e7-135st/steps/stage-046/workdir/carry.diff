+    print(f"Timed out:    {len(res.timed_out)}")
+    if res.timed_out:
+        print(f"  {', '.join(res.timed_out)}")
+    print(f"Auto-blocked: {len(res.auto_blocked)}")
+    if res.auto_blocked:
+        print(f"  {', '.join(res.auto_blocked)}")
+    print(f"Promoted:     {res.promoted}")
+    print(f"Spawned:      {len(res.spawned)}")
