+    @staticmethod
+    def _strip_at_mention(content: str) -> str:
+        """Strip the @bot mention prefix from group message content."""
+        # QQ group @-messages may have the bot's QQ/ID as prefix
+        import re
+        stripped = re.sub(r'^@\S+\s*', '', content.strip())
+        return stripped
