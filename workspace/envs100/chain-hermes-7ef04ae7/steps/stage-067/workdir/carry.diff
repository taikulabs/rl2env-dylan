+      bucket.set(key, targetAlpha)
+
+      return targetAlpha
+    }
+
+    animating = true
+    bucket.set(key, next)
+
+    return next
+  }
+
+  const shade = (a: number) => `rgba(${base.r},${base.g},${base.b},${a})`
