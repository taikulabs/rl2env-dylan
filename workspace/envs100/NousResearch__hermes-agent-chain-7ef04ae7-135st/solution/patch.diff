-  return (
-    <>
-      {Array.from(text, (ch, i) =>
-        GLYPH_SET.has(ch) ? (
-          <span className="text-[0.62em]" key={i}>
-            {ch}
-          </span>
-        ) : (
-          ch
-        )
-      )}
-    </>
-  )
-}
