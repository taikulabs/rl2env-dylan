+        entry = self._seed("ANTHROPIC_API_KEY", "sk-ant-admin-fake-12345")
+        assert entry.auth_type == AUTH_TYPE_API_KEY
+
+    def test_standard_api_key_classified_as_api_key(self, isolated_hermes_home):
