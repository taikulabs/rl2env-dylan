+export interface Scene {
+  adjacency: Map<string, Set<string>>
+  byId: Map<string, SimNode>
+  ctx: CanvasRenderingContext2D
+  dpr: number
+  fades: FadeBuckets
+  focusId: null | string
+  hoverId: null | string
+  hoverLink: null | string
+  hoverRing: null | number
