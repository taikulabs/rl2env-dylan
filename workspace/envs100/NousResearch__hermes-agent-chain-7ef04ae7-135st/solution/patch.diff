+  // Inter-ring bands: a theme-tinted wash sliver at the outer edge; the lit
+  // date's band flattens to an even wash.
+  if (bandAlpha > 0 || litRingIdx != null) {
+    for (let i = 0; i < rings.length - 1; i += 1) {
