+      shapePath(ctx, shape, sx, sy, r)
+      ctx.fillStyle = rgba(nodeInk, 1)
+      ctx.fill()
+    }
+
+    if (isFocus) {
+      ctx.globalAlpha = 1
+      ctx.strokeStyle = rgba(nodeInk, 1)
