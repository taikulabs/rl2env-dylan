+    const coreFade = i === 0 ? clamp(reveal / 0.08, 0, 1) : 1
+    const ringAlphaNow = fadeAlpha(fades.rings, String(i), emphasisAlpha, emphasized) * (ringVis[i] ?? 1) * coreFade
+
