+
+    from tools.xai_http import build_xai_storage_options
+
+    storage = build_xai_storage_options(
+        "video_gen",
+        filename_prefix="hermes-xai-video",
+        extension="mp4",
+    )
+
+    assert storage is not None
+    assert storage["expires_after"] == 172800
