+def session_fingerprint(meta: Dict[str, Any]) -> Dict[str, Any]:
+    return {
+        "last_active": meta.get("last_active"),
+        "started_at": meta.get("started_at"),
+        "model": meta.get("model"),
+        "title": meta.get("title") or meta.get("preview") or "Untitled",
