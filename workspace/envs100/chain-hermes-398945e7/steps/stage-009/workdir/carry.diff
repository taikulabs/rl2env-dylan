+  const cMin = Math.floor((center.canvasX - radiusPx - rPad) / CELL_W);
+  const cMax = Math.ceil((center.canvasX + radiusPx + rPad) / CELL_W);
+  for (let r = rMin; r <= rMax; r++) {
+    const y = r * CELL_H + CELL_H * 0.5;
