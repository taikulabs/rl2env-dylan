+  const obstacleScale = spaceStart + (1 - spaceStart) * spaceGrow;
+  const rMin = Math.floor((center.canvasY - radiusPx - rPad) / CELL_H);
+  const rMax = Math.ceil((center.canvasY + radiusPx + rPad) / CELL_H);
