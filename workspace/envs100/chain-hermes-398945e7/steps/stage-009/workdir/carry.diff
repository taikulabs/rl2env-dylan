+  if (cubeWeight > 0.001) {
+    rasterizeCubeWire(center, radiusPx, buildPhase, cubeOrbitX, cubeOrbitY, cubeWeight);
+  }
+  if (sphereWeight <= 0.001) {
+    mergeObstacleRows();
+    return;
+  }
