+  const sphereObstacleRows = collectSphereObstacleRows(center, radiusNorm, obstacleScale, rPad);
+  const cubeObstacleRows = collectCubeObstacleRows(center, radiusPx, cubeOrbitX, cubeOrbitY, obstacleScale);
