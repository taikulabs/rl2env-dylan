+  // Wheel up = 64 (0x40), wheel down = 65 (0x41).
+  // Modifier bits: shift = 0x04, meta = 0x08, ctrl = 0x10.
+  const sgrWheel = (button: number) => `\x1b[<${button};10;10M`
