+    def test_exchange_code_posts_pkce_payload(self, monkeypatch):
+        from agent import antigravity_oauth
+
+        captured = {}
+
+        def fake_post(url, data, timeout):
+            captured.update({"url": url, "data": data, "timeout": timeout})
