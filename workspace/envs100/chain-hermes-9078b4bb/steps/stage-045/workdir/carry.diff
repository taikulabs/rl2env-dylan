+
+    Returns the findings (also for tests). Never raises. Idempotent unless
+    ``force=True`` (used by tests).
+    """
+    global _AUDIT_RAN
+    if _AUDIT_RAN and not force:
+        return []
+    _AUDIT_RAN = True
+    try:
