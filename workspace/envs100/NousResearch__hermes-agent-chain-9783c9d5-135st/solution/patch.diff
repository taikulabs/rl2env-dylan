+_FEISHU_OPUS_UPLOAD_EXTENSIONS = {".ogg", ".opus"}
+_FEISHU_MEDIA_UPLOAD_EXTENSIONS = {".mp4", ".mov", ".avi", ".m4v"}
+_FEISHU_DOC_UPLOAD_TYPES = {
