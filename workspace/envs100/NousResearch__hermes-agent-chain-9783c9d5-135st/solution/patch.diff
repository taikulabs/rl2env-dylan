+    # TIER 2: ENCODING + FRAMING (12-22)
+    {'name': 'reversed',     'label': 'Reversed',    'tier': 2, 'fn': _apply_reversed},
+    {'name': 'superscript',  'label': 'Superscript', 'tier': 2, 'fn': _apply_superscript},
