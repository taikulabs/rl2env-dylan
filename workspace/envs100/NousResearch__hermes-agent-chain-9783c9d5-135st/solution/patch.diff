+    if re.search(r'\b(?:I hope this helps|Let me know if you (?:need|have|want)|Feel free to ask|Happy to (?:help|clarify))\b', content, re.I):
+        score -= 20
+
+    return {'score': score, 'is_refusal': False, 'hedge_count': hedge_count}
