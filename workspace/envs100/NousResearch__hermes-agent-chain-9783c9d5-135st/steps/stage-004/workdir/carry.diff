-        return None
-
-    if not auth_code:
-        print("No code entered.")
-        return None
-
-    # Split code#state format
-    splits = auth_code.split("#")
-    code = splits[0]
-    state = splits[1] if len(splits) > 1 else ""
-
-    # Exchange code for tokens
