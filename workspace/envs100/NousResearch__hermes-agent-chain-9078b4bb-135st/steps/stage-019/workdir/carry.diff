  * Watch a child process's stdout for the `HERMES_DASHBOARD_READY port=<N>`
  * line that web_server.py prints after uvicorn binds its socket.
@@ -9,11 +36,15 @@ const _READY_RE = /^HERMES_DASHBOARD_READY port=(\d+)/m
