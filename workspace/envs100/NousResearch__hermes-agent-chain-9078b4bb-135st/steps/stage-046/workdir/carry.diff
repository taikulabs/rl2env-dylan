-        from agent.gemini_cloudcode_adapter import _gemini_http_error
-        from agent.error_classifier import classify_api_error, FailoverReason
-
-        body = {
-            "error": {
-                "code": 429,
-                "message": "Resource has been exhausted",
-                "status": "RESOURCE_EXHAUSTED",
-                "details": [
