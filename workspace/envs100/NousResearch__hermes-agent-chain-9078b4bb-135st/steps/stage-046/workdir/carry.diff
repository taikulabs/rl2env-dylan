-    def access_token_expired(self, skew_seconds: int = REFRESH_SKEW_SECONDS) -> bool:
-        if not self.access_token or not self.expires_ms:
-            return True
-        return (time.time() + max(0, skew_seconds)) * 1000 >= self.expires_ms
