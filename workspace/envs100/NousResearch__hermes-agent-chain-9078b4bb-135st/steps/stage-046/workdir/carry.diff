-                        "metadata": {"model": "gemini-2.5-pro"},
-                    }
-                ],
-            }
-        }
-        err = _gemini_http_error(self._fake_response(429, body))
-
-        classified = classify_api_error(
-            err, provider="google-gemini-cli", model="gemini-2.5-pro",
-        )
