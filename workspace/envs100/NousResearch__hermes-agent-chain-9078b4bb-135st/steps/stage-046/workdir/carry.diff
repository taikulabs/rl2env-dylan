-    def parse(cls, packed: str) -> "RefreshParts":
-        if not packed:
-            return cls(refresh_token="")
-        parts = packed.split("|", 2)
-        return cls(
-            refresh_token=parts[0],
-            project_id=parts[1] if len(parts) > 1 else "",
-            managed_project_id=parts[2] if len(parts) > 2 else "",
-        )
