-def _secret_candidates(raw: str) -> list[str]:
-    candidates: list[str] = []
-    for length in (35, 34, 36, 33, 37, 38, 39, 40, 41, 42):
-        if len(raw) >= length:
-            candidates.append(raw[:length])
-    candidates.append(raw)
-    return list(dict.fromkeys(candidates))
