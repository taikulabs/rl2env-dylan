+    try:
+        active = _get_active_memory_provider()
+    except Exception:
+        active = None
+    if not active:
+        return []
+
+    try:
+        provider = load_memory_provider(active)
+    except Exception:
+        provider = None
+    if provider is None:
+        return []
+
+    try:
+        declared = provider.backup_paths() or []
+    except Exception as exc:
+        logger.warning("backup_paths() failed for memory provider %r: %s", active, exc)
