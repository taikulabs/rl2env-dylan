+    for leaked in ("ITERM_SESSION_ID", "KITTY_WINDOW_ID", "WEZTERM_PANE"):
+        monkeypatch.setenv(leaked, "1")
+        assert render.detect_terminal_graphics() == "unicode"
+        monkeypatch.delenv(leaked)
