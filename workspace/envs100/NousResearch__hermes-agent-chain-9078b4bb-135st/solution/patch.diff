+        print(f"    Embedder: {oss_config['embedder']['provider']} ({oss_config['embedder']['config'].get('model', '')})")
+        print(f"    Vector: {vector_id}")
+        if env_writes:
+            print(f"    Env vars: {', '.join(env_writes.keys())}")
