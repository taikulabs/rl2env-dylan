+                        "aes_key": kwargs["aes_key_b64"],
+                        "encrypt_type": 1,
+                    },
+                    "video_size": kwargs["ciphertext_size"],
+                },
+            }
+        return MEDIA_FILE, lambda **kwargs: {
+            "type": ITEM_FILE,
+            "file_item": {
+                "media": {
+                    "encrypt_query_param": kwargs["encrypt_query_param"],
+                    "aes_key": kwargs["aes_key_b64"],
+                    "encrypt_type": 1,
+                },
+                "file_name": kwargs["filename"],
+                "len": str(kwargs["plaintext_size"]),
+            },
+        }
