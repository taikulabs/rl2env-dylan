+    code, msg, data = _do_request(
+        client, "POST", _ADD_COMMENT_URI,
+        paths={"file_token": file_token},
+        body=body,
+    )
+    if code != 0:
+        return tool_error(f"Add comment failed: code={code} msg={msg}")
