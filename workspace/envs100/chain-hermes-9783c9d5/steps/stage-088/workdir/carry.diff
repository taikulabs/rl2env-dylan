+                return
+            app = getattr(getattr(response, "data", None), "app", None)
+            app_name = (getattr(app, "app_name", None) or "").strip()
+            if app_name:
+                self._bot_name = app_name
+        except Exception:
+            logger.debug("[Feishu] Failed to hydrate bot identity", exc_info=True)
