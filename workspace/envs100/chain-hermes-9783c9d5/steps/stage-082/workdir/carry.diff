+    )
+    for msg in messages:
+        content = msg.get("content", "")
+        if isinstance(content, (list, dict)):
+            content = json.dumps(content)
+        conn.execute(
+            "INSERT INTO messages (session_id, role, content, timestamp, tool_calls) VALUES (?, ?, ?, ?, ?)",
