+def _linux_pactl_result(stdout: str) -> MagicMock:
+    """Build a fake CompletedProcess-ish object for subprocess.run."""
+    m = MagicMock()
+    m.stdout = stdout
+    m.stderr = ""
+    m.returncode = 0
+    return m
+
