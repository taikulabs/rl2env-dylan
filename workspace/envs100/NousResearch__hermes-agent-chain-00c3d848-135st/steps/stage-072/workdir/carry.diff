+        protocol.decode("[]")  # list, not object
+    with pytest.raises(ValueError):
+        protocol.decode(json.dumps({"id": "x"}))  # missing type
+    with pytest.raises(ValueError):
+        protocol.decode(json.dumps({"type": "ping"}))  # missing id
