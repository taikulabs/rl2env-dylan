+        + _encode_field(2, WT_LEN, _encode_message(auth_buf))
+        + _encode_field(3, WT_LEN, _encode_message(dev_buf))
+    )
+    if route_env:
+        req_buf += _encode_field(5, WT_LEN, _encode_string(route_env))
