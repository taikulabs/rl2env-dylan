+        head = dec["head"]
+        assert head["cmd_type"] == CMD_TYPE["Request"]
+        assert head["cmd"] == "auth-bind"
+        assert head["seq_no"] == 99
+        assert head["msg_id"] == "abc123"
+        assert head["module"] == "conn_access"
