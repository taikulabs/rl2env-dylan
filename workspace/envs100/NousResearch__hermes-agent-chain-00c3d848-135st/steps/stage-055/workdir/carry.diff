+    @pytest.mark.asyncio
+    async def test_onion_model(self):
+        """Middlewares support before/after processing (onion model)."""
+        order = []
+
+        async def mw_outer(ctx, next_fn):
+            order.append("outer-before")
+            await next_fn()
+            order.append("outer-after")
+
+        async def mw_inner(ctx, next_fn):
+            order.append("inner")
+            await next_fn()
