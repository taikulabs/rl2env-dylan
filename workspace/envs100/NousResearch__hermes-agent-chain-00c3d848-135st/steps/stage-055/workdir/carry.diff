+    def test_full_round_trip(self):
+        """encode_conn_msg_full 含 cmd/msg_id/module"""
+        enc = encode_conn_msg_full(
+            cmd_type=CMD_TYPE["Request"],
+            cmd="auth-bind",
+            seq_no=99,
+            msg_id="abc123",
+            module="conn_access",
+            data=b"\xde\xad\xbe\xef",
+        )
