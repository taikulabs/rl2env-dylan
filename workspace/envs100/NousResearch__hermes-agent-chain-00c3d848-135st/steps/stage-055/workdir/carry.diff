+# ===========================================================
+# 9. seq_no 生成
+# ===========================================================
+
+class TestSeqNo:
+    def test_monotonic(self):
+        a = next_seq_no()
+        b = next_seq_no()
+        c = next_seq_no()
+        assert b > a
+        assert c > b
+
+    def test_thread_safety(self):
+        import threading
+        results = []
+        lock = threading.Lock()
+
+        def worker():
+            for _ in range(100):
+                v = next_seq_no()
+                with lock:
+                    results.append(v)
+
+        threads = [threading.Thread(target=worker) for _ in range(10)]
+        for t in threads:
+            t.start()
+        for t in threads:
+            t.join()
+
+        # 无重复
+        assert len(results) == len(set(results)), "duplicate seq_no detected"
+
