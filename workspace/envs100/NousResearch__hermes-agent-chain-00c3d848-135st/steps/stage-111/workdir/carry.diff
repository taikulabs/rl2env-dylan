-def _split_tree_text(full_text: str) -> Tuple[str, str]:
-    """Split get_window_state text into (summary_line, tree_markdown)."""
-    lines = full_text.split("\n", 1)
-    summary = lines[0]
-    tree = lines[1] if len(lines) > 1 else ""
-    return summary, tree
